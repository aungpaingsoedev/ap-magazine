# Database (SQLite file path)
# Relative paths resolve from the project root.
DATABASE_URL=./data/cms.db

# Application
# Local Next: http://localhost:3000
# Docker compose publishes http://localhost:3000 (compose uses these defaults)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Initial administrator
ADMIN_EMAIL=

# Scheduled publishing endpoint
CRON_SECRET=

# Docker: seed demo data when the app container starts (1 = on, 0 = off)
# Default is on for docker compose up
SEED_ON_START=1
